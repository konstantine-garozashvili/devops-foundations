# Global
APP_ENV=development

# Backend service
BACKEND_HOST=backend
BACKEND_PORT=3000
BACKEND_LOG_LEVEL=info

# Frontend service
FRONTEND_HOST=frontend
FRONTEND_PORT=8080

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=devops_foundations
POSTGRES_USER=devops_user
POSTGRES_PASSWORD=devops_password_change_me

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# MailHog (SMTP + UI)
MAILHOG_HOST=mailhog
MAILHOG_SMTP_PORT=1025
MAILHOG_HTTP_PORT=8025

# Traefik / TLS (for local mkcert setup)
TRAEFIK_DOMAIN_SUFFIX=localhost
TRAEFIK_CERTS_PATH=./certs

# Security / misc (example placeholders only)
CONTACT_FORM_DEFAULT_TO=devops@example.local

